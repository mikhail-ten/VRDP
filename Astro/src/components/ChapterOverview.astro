---
import chapters from '../data/arborescence.json';

interface Props {
	chapter: string;
}

const chapter = chapters.find(({ slug }) => slug === Astro.props.chapter);
if (!chapter) throw new Error(`Chapitre inconnu : ${Astro.props.chapter}`);
const basePath = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<nav aria-label={`Sous-chapitres : ${chapter.title}`}>
	<ul>
		{chapter.pages.map((page) => (
			<li><a href={`${basePath}${chapter.slug}/${page.slug}/`}>{page.title}</a></li>
		))}
	</ul>
</nav>
