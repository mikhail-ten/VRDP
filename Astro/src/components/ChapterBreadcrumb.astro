---
import chapters from '../data/arborescence.json';

interface Props {
	chapter: string;
}

const chapter = chapters.find(({ slug }) => slug === Astro.props.chapter);
if (!chapter) throw new Error(`Chapitre inconnu : ${Astro.props.chapter}`);
const basePath = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<nav class="chapter-breadcrumb" aria-label="Fil d’Ariane">
	<a href={basePath}>Accueil</a>
	<span aria-hidden="true"> / </span>
	<a href={`${basePath}${chapter.slug}/`}>{chapter.title}</a>
</nav>

<style>
	.chapter-breadcrumb {
		margin-bottom: 2rem;
		font-size: 0.9rem;
		color: var(--brand-muted);
	}
</style>
