---
import { Icon } from '@astrojs/starlight/components';
import chapters from '../data/arborescence.json';

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const features = chapters.map((chapter) => ({
    title: chapter.title,
    description: chapter.pages.slice(0, 3).map((page) => page.title).join(' · ') +
        (chapter.pages.length > 3 ? '…' : ''),
    href: `${basePath}${chapter.slug}/`,
    icon: 'open-book' as const,
    count: chapter.pages.length,
}));
---

<script is:inline>
	document.documentElement.classList.add('home-motion-enabled');
</script>

<section class="home-features" aria-labelledby="home-features-title">
	<h2 id="home-features-title">Chapitres</h2>
	<div class="feature-grid">
		{
			features.map((feature) => (
				<a
					class="feature-card"
					href={feature.href}
					data-home-reveal
				>
					<span class="feature-icon" aria-hidden="true">
						<Icon name={feature.icon} size="1.7rem" />
					</span>
					<span class="feature-title">{feature.title}</span>
					<span class="feature-description">{feature.description}</span>
					<span class="feature-cta">
						{feature.count} {feature.count === 1 ? 'sous-chapitre' : 'sous-chapitres'}
						<Icon name="right-arrow" size="1rem" class="feature-arrow rtl:flip" />
					</span>
				</a>
			))
		}
	</div>
</section>

<script>
	const revealItems = document.querySelectorAll<HTMLElement>('[data-home-reveal]');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!reducedMotion && 'IntersectionObserver' in window) {
		const cardObserver = new IntersectionObserver(
			(entries, observer) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
						entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			},
			{ rootMargin: '0px 0px -28% 0px', threshold: 0.12 }
		);

		for (const item of revealItems) {
			cardObserver.observe(item);
		}
	} else {
		for (const item of revealItems) {
			item.classList.add('is-visible');
		}
	}
</script>

<style>
	.home-features {
		margin-block: clamp(3rem, 8vh, 6rem) 4rem;
	}

	.home-features h2 {
		margin: 0;
		color: var(--brand-ink);
		font-size: 2.35rem;
		font-weight: 700;
		letter-spacing: 0;
		line-height: 1.1;
		text-align: center;
		animation: home-feature-rise 1950ms cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	:global(.home-motion-enabled) .home-features [data-home-reveal] {
		opacity: 0;
		translate: 0 4.5rem;
	}

	:global(.home-motion-enabled) .home-features [data-home-reveal].is-visible {
		animation: home-feature-rise 1950ms cubic-bezier(0.16, 1, 0.3, 1) both;
		animation-delay: var(--feature-delay, 0ms);
	}

	@keyframes home-feature-rise {
		from {
			opacity: 0;
			translate: 0 4.5rem;
		}

		to {
			opacity: 1;
			translate: 0 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-features h2,
		:global(.home-motion-enabled) .home-features [data-home-reveal] {
			opacity: 1;
			translate: none;
			animation: none;
		}
	}

	.feature-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		margin-top: 2rem;
	}

	.feature-card {
		position: relative;
		display: flex;
		overflow: hidden;
		min-height: 15rem;
		flex-direction: column;
		gap: 1rem;
		border: 1px solid var(--brand-line);
		border-radius: 0.5rem;
		background: var(--brand-paper);
		padding: 1.6rem;
		box-shadow: 0 0.8rem 2rem rgb(0 0 0 / 6%);
		text-decoration: none;
		transition:
			background-color 160ms ease,
			border-color 160ms ease,
			box-shadow 160ms ease,
			transform 160ms ease;
	}

	.feature-card::before {
		position: absolute;
		inset: 0 0 auto;
		height: 0.18rem;
		background: var(--brand-red);
		content: '';
		opacity: 0;
		transition: opacity 160ms ease;
	}

	.feature-card:hover,
	.feature-card:focus-visible {
		border-color: var(--brand-red-border);
		background-color: color-mix(in srgb, var(--brand-paper) 94%, var(--brand-red));
		box-shadow: 0 1rem 2.4rem rgb(0 0 0 / 10%);
		transform: translateY(-0.125rem);
	}

	.feature-card:hover::before,
	.feature-card:focus-visible::before {
		opacity: 1;
	}

	.feature-card:focus-visible {
		outline: 2px solid var(--brand-red);
		outline-offset: 3px;
	}

	.feature-icon {
		display: inline-flex;
		width: 3.9rem;
		height: 3.9rem;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.45rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}

	.feature-title {
		margin-top: 0.55rem;
		color: var(--brand-ink);
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.3;
		overflow-wrap: anywhere;
	}

	.feature-description {
		color: var(--brand-muted);
		font-size: 1rem;
		line-height: 1.65;
	}

	.feature-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin-top: auto;
		color: var(--brand-red);
		font-size: 0.95rem;
		font-weight: 700;
	}

	.feature-arrow {
		transition: transform 160ms ease;
	}

	.feature-card:hover .feature-arrow,
	.feature-card:focus-visible .feature-arrow {
		transform: translateX(0.15rem);
	}

	@media (min-width: 48rem) {
		.home-features h2 {
			font-size: 3rem;
		}

		.feature-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.25rem;
			margin-top: 2.6rem;
		}

		.feature-card {
			padding: 1.9rem;
		}
	}
</style>
